{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haunt",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",

  // The Worker sees every request first so it can put the right photo and
  // title into link previews. Anything it doesn't handle is a plain file.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "vars": {
    // Voting closes here. -05:00 is Chicago daylight time, still in effect on Oct 31.
    "VOTING_ENDS": "2026-10-31T23:59:00-05:00"
  },

  // No ids on purpose: the first `wrangler deploy` creates the database and
  // the photo store and attaches them to the Worker; later deploys reuse them.
  // Houses and votes:
  "d1_databases": [
    { "binding": "DB", "database_name": "haunt" }
  ],
  // Photo files:
  "kv_namespaces": [
    { "binding": "PHOTOS" }
  ]

  // Secret, set once and never committed:
  //   ADMIN_CODE - the passcode for /admin
}
